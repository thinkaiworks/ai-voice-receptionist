PORT=3002
# The public https URL Twilio calls (used to verify Twilio's signature)
PUBLIC_URL=https://your-app.example.com
# Set to the business's time zone so slots are offered in local time
TZ=America/New_York

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=+15555550123
# Amazon Polly neural voice used by Twilio <Say>
TTS_VOICE=Polly.Joanna-Neural

# Bookings, transfers and missed calls are POSTed here (n8n / Make / GoHighLevel / Slack workflow)
OWNER_WEBHOOK_URL=

BUSINESS_FILE=config/business.json
BOOKINGS_FILE=data/bookings.json
